# SQL to Snowflake MCP Server Configuration

# Python environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# MCP Server settings
MCP_RESOURCES_PATH=./dist
MCP_CONFIG_PATH=./mcp-resources.json
MCP_DEBUG=0

# Resource paths
SOURCE_SCHEMA_PATH=./sql2snowflakeMapper/Source_Schema
TARGET_SCHEMA_PATH=./sql2snowflakeMapper/Target_Schema

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
